# Jira Cloud API Configuration
# Get your API Token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token

# AI Provider Configuration
# Leave OPENAI_API_KEY blank to automatically use the FREE built-in OpenAI API!
# Or provide your OpenAI, OpenRouter, Groq, or Gemini OpenAI-compatible API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to apps/backend/jira_assistant.db)
DATABASE_PATH=jira_assistant.db
