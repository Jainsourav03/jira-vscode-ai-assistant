{
  "name": "jira-assistant",
  "displayName": "Jira Assistant",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:jira-assistant.hello",
    "onCommand:jira-assistant.openPanel",
    "onCommand:jira-assistant.mockTicket",
    "onCommand:jira-assistant.connectBackend",
    "onCommand:jira-assistant.openLatestTicket",
    "onCommand:jira-assistant.openSettings",
    "onCommand:jira-assistant.showConnectionStatus",
    "onCommand:jira-assistant.statusBarMenu",
    "onCommand:jira-assistant.showRecentTickets",
    "onCommand:jira-assistant.disconnectBackend",
    "onCommand:jira-assistant.reconnectBackend"
],
  "contributes": {
  "commands": [
    {
      "command": "jira-assistant.hello",
      "title": "Jira Assistant: Hello"
    },
    {
  "command": "jira-assistant.openLatestTicket",
  "title": "Jira Assistant: Open Latest Ticket"
},
    {
      "command": "jira-assistant.openPanel",
      "title": "Jira Assistant: Open Panel"
    },
    {
  "command": "jira-assistant.showRecentTickets",
  "title": "Jira Assistant: Show Recent Tickets"
},
{
  "command": "jira-assistant.openSettings",
  "title": "Jira Assistant: Open Settings"
},  
    {
      "command": "jira-assistant.mockTicket",
      "title": "Jira Assistant: Show Mock Ticket Notification"
    },
    {
      "command": "jira-assistant.connectBackend",
      "title": "Jira Assistant: Connect Backend"
    },
    {
       "command":"jira-assistant.openLatestTicket",
"title":"Jira Assistant: Open Latest Ticket"
},
{
  "command": "jira-assistant.disconnectBackend",
  "title": "Jira Assistant: Disconnect Backend"
},
{
  "command": "jira-assistant.reconnectBackend",
  "title": "Jira Assistant: Reconnect Backend"
},

{
  "command": "jira-assistant.showConnectionStatus",
  "title": "Jira Assistant: Show Connection Status"
},
{
    "command": "jira-assistant.statusBarMenu",
    "title": "Jira Assistant Menu"
}
  ],

 "configuration": {
  "title": "Jira Assistant",

  "properties": {

    "jiraAssistant.backendUrl": {
      "type": "string",
      "default": "http://localhost:8000",
      "description": "Backend REST API URL"
    },

    "jiraAssistant.websocketUrl": {
      "type": "string",
      "default": "ws://localhost:8000/ws/client",
      "description": "Backend WebSocket URL"
    },

    "jiraAssistant.userEmail": {
      "type": "string",
      "default": "",
      "description": "Developer email"
    },

    "jiraAssistant.autoConnect": {
      "type": "boolean",
      "default": false,
      "description": "Automatically connect to backend"
    },

    "jiraAssistant.showNotifications": {
      "type": "boolean",
      "default": true,
      "description": "Show Jira ticket notifications"
    }

  }
}
},
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
